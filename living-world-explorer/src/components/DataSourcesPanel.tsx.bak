import { useEffect, useMemo, useRef, useState, type ReactNode } from 'react'
import { useLocation, useNavigate } from 'react-router-dom'
import { PanelContainer } from './PanelContainer'
import { useWorldStore } from '../store/worldStore'
import { useRefreshStore } from '../store/refreshStore'
import { fetchActors } from '../api/actorClient'
import { fetchActorCognitiveState, type ActorCognitiveState } from '../api/cognitiveClient'
import {
  fetchExecutionPlanningContext, fetchExecutionSemanticMemory, externalEventsFrom,
  type ContextSnapshotDto, type SemanticMemoryDto,
} from '../api/contextClient'
import { ActorSection, ActorTable, formatTime, readable } from './inspectorPrimitives'
import { ExecutionGraphPanel } from './ExecutionGraphPanel'
import { ConversationTimelinePanel } from './ConversationTimelinePanel'
import { MapPanel } from './MapPanel'
import { InspectorPanel } from './InspectorPanel'
import { ExecutionHistoryPanel } from './ExecutionHistoryPanel'
import { MemoryPanel } from './MemoryPanel'
import { PlanReplacementHistoryPanel } from './PlanReplacementHistoryPanel'
import { PlanningDetailsPanel } from './PlanningDetailsPanel'
import { AgentsPanel } from './AgentsPanel'
import { SocietiesPanel } from './SocietiesPanel'
import { GeographyPanel } from './GeographyPanel'
import { EventStreamPanel } from './EventStreamPanel'
import { AffiliationsPanel } from './AffiliationsPanel'
import { KnowledgeGraphPanel } from './KnowledgeGraphPanel'
import { ContextMemoryPanel } from './ContextMemoryPanel'
import './InspectorPanel.css'

const NAV_ROUTES: Record<string, string> = {
  Dashboard: '/dashboard', Actors: '/actors', Societies: '/societies', 'World Map': '/world-map', Timeline: '/timeline',
  Debugger: '/execution-debugger/grounding', 'Plan Analyzer': '/plan-analyzer', 'Game Theory': '/game-theory',
  Negotiations: '/negotiations', Reports: '/reports', 'Knowledge Graph': '/knowledge-graph', 'Context Stream': '/context-stream',
  Memories: '/memories', Affiliations: '/affiliations', 'Lemon Metrics': '/lemon-metrics', Providers: '/providers', Settings: '/settings',
}
const TAB_ROUTES: Record<string, string> = { Overview: 'overview', Plan: 'plan', Grounding: 'grounding', Conversations: 'conversations', 'World Impact': 'world-impact', Metrics: 'metrics', Logs: 'logs' }

function DashboardFrame({ dashboard, children, onExport, debuggerPage = true }: { dashboard: boolean; children: ReactNode; onExport?: () => void; debuggerPage?: boolean }) {
  const navigate = useNavigate()
  const location = useLocation()
  const [activeNav, setActiveNav] = useState('Debugger')
  const [activeTab, setActiveTab] = useState('Grounding')
  useEffect(() => {
    const path = location.pathname
    const navMatch = Object.entries(NAV_ROUTES).find(([, route]) => route === path || (route !== '/' && path.startsWith(route)))
    if (path === '/dashboard' || path === '/execution-debugger' || path.endsWith('/grounding')) setActiveNav('Debugger')
    else if (path === '/agents' || navMatch?.[0] === 'Actors') setActiveNav('Actors')
    else if (navMatch) setActiveNav(navMatch[0])
    const tabMatch = Object.entries(TAB_ROUTES).find(([, slug]) => path.endsWith(`/${slug}`))
    if (tabMatch) setActiveTab(tabMatch[0])
  }, [location.pathname])
  const nav = (label: string) => { setActiveNav(label); navigate(NAV_ROUTES[label] ?? '/') }
  const tab = (label: string) => { setActiveTab(label); navigate(`/execution-debugger/${TAB_ROUTES[label]}`) }
  const dashboardHome = false
  if (!dashboard) return <PanelContainer title="Data Sources">{children}</PanelContainer>
  return <div className="lwe-dashboard">
    <aside className="lwe-dashboard-sidebar">
      <div className="lwe-dashboard-logo"><span>⚛</span> CognitiveOS <span className="lwe-dashboard-chevron">⌄</span></div>
      <div className="lwe-dashboard-nav-label">OVERVIEW</div>
      {['⌂  Dashboard', '♙  Actors', '♧  Societies', '◉  World Map', '▣  Timeline'].map((item) => <button key={item} type="button" onClick={() => nav(item.slice(3))} className={`lwe-dashboard-nav-item${activeNav === item.slice(3) ? ' active' : ''}`}>{item}</button>)}
      <div className="lwe-dashboard-nav-label">ANALYSIS</div>
      <button type="button" onClick={() => nav('Debugger')} className={`lwe-dashboard-nav-item${activeNav === 'Debugger' ? ' active' : ''}`}>▧  Debugger</button>
      {['⌘  Plan Analyzer', '♧  Game Theory', '◌  Negotiations', '▤  Reports'].map((item) => <button key={item} type="button" onClick={() => nav(item.slice(3))} className={`lwe-dashboard-nav-item${activeNav === item.slice(3) ? ' active' : ''}`}>{item}</button>)}
      <div className="lwe-dashboard-nav-label">DATA</div>
      {['⌘  Knowledge Graph', '▤  Context Stream', '◉  Memories', '♧  Affiliations'].map((item) => <button key={item} type="button" onClick={() => nav(item.slice(3))} className={`lwe-dashboard-nav-item${activeNav === item.slice(3) ? ' active' : ''}`}>{item}</button>)}
      <div className="lwe-dashboard-nav-label">SYSTEM</div>
      {['⌁  Lemon Metrics', '◉  Providers', '⚙  Settings'].map((item) => <button key={item} type="button" onClick={() => nav(item.slice(3))} className={`lwe-dashboard-nav-item${activeNav === item.slice(3) ? ' active' : ''}`}>{item}</button>)}
      <div className="lwe-dashboard-health"><span>System Status</span><strong>Healthy</strong><div className="lwe-dashboard-sparkline">╱╲╱╲╱╲╱╱</div></div>
    </aside>
    <main className="lwe-dashboard-main">
      <header className="lwe-dashboard-header">
        <div className="lwe-dashboard-breadcrumb">Living World Explorer <b>›</b> Debugger</div>
        <div className="lwe-dashboard-header-actions"><div className="lwe-dashboard-search">⌕ &nbsp; Search anything...</div><span>◎</span><span>♧</span><span className="lwe-dashboard-avatar">PS</span><span className="lwe-dashboard-user">Priya Sharma<small>Customer</small></span></div>
      </header>
      <div className="lwe-dashboard-pagehead"><div><h1>{debuggerPage ? (dashboardHome ? 'CognitiveOS Dashboard' : 'Debugger') : activeNav} <span>{debuggerPage ? (dashboardHome ? 'Live' : 'Completed') : 'Live'}</span></h1><p>{debuggerPage ? (dashboardHome ? 'Living world operations and cognitive execution overview' : 'Grounding view · persisted planner context and execution evidence') : `CognitiveOS ${activeNav.toLowerCase()} workspace`}</p></div>{debuggerPage && <><button type="button" onClick={() => tab('Grounding')}>Compare</button><button type="button" onClick={onExport}>Export Report⌄</button></>}</div>
      {debuggerPage && <nav className="lwe-dashboard-tabs">{['Overview', 'Plan', 'Grounding', 'Conversations', 'World Impact', 'Metrics', 'Logs'].map((item) => <button type="button" key={item} onClick={() => tab(item)} className={activeTab === item ? 'selected' : ''}>{item === 'Grounding' ? '▧' : '◉'} &nbsp; {item}</button>)}</nav>}
      {children}
    </main>
  </div>
}

function DashboardPage({ title, description }: { title: string; description: string }) {
  return <div className="lwe-dashboard-placeholder-page">
    <div className="lwe-dashboard-placeholder-icon">◈</div>
    <h2>{title}</h2>
    <p>{description}</p>
    <div className="lwe-dashboard-placeholder-grid"><div>Live data source</div><div>Execution-aware view</div><div>Coming online with the selected actor</div></div>
  </div>
}

/**
 * A peer of World Tree / Map / Execution Graph / Inspector — not a
 * sub-section buried inside another panel's scroll. Whichever actor is
 * selected (World Tree "BY ACTOR" tab, or the Map), this panel shows what
 * grounded their most recent real planning cycle: Knowledge Graph, Context
 * Stream, Semantic Memory, Affiliation Graph, World State, and External
 * Events — automatically, with no click required beyond selecting the
 * actor.
 */
export function DataSourcesPanel({ dashboard = false }: { dashboard?: boolean }) {
  const selectedActorId = useWorldStore((s) => s.selectedActorId)
  const refreshSeq = useRefreshStore((s) => s.refreshSeq)
  const location = useLocation()

  const [cognitiveState, setCognitiveState] = useState<ActorCognitiveState | null>(null)
  const [executionId, setExecutionId] = useState<string | null>(null)
  const [snapshot, setSnapshot] = useState<ContextSnapshotDto | null>(null)
  const [semanticMemory, setSemanticMemory] = useState<SemanticMemoryDto | null>(null)
  const [error, setError] = useState('')
  const [search, setSearch] = useState('')
  const lastActorIdRef = useRef<string | null>(null)
  // Dashboard is the full CognitiveOS home surface; Grounding is the same
  // live evidence surface under Execution Debugger. Other routes are
  // intentionally independent page shells.
  const groundingRoute = location.pathname === '/' || location.pathname === '/dashboard' || location.pathname === '/execution-debugger' || location.pathname.endsWith('/grounding')
  
  // Determine active filter based on current tab
  const activeFilter = useMemo(() => {
    const path = location.pathname
    if (path.endsWith('/memories') || path.endsWith('/overview')) return 'all'
    if (path.endsWith('/grounding') || path.endsWith('/plan')) return 'kg'
    if (path.endsWith('/conversations') || path.endsWith('/world-impact') || path.endsWith('/metrics')) return 'semantic'
    if (path.endsWith('/logs')) return 'diff'
    return 'all'
  }, [location.pathname])

  useEffect(() => {
    if (!dashboard || selectedActorId) return
    let cancelled = false
    fetchActors().then((actors) => {
      if (!cancelled && actors.length > 0) useWorldStore.getState().selectActor(actors[0].actor_id)
    }).catch(() => { /* the normal panel error state will explain API failures */ })
    return () => { cancelled = true }
  }, [dashboard, selectedActorId])

  useEffect(() => {
    const switchingActor = lastActorIdRef.current !== selectedActorId
    lastActorIdRef.current = selectedActorId
    if (switchingActor) {
      setCognitiveState(null)
      setExecutionId(null)
      setSnapshot(null)
      setSemanticMemory(null)
      setError('')
    }
    if (!selectedActorId) return
    let cancelled = false
    fetchActorCognitiveState(selectedActorId)
      .then((result) => {
        if (cancelled) return
        setCognitiveState(result)
        const latest = result.execution_history.find(
          (e) => typeof e.metadata.execution_id === 'string' && e.metadata.execution_id,
        )
        setExecutionId(latest ? (latest.metadata.execution_id as string) : null)
      })
      .catch((err) => { if (!cancelled) setError(err instanceof Error ? err.message : String(err)) })
    return () => { cancelled = true }
  }, [selectedActorId, refreshSeq])

  useEffect(() => {
    if (!selectedActorId || !executionId) {
      setSnapshot(null)
      setSemanticMemory(null)
      return
    }
    let cancelled = false
    Promise.all([
      fetchExecutionPlanningContext(selectedActorId, executionId),
      fetchExecutionSemanticMemory(selectedActorId, executionId),
    ])
      .then(([snap, memory]) => {
        if (cancelled) return
        // Snapshots written before the grounding schema was extended do not
        // contain the newer arrays. Normalize at the API boundary so the
        // panel remains readable while those executions age out.
        setSnapshot({
          ...snap,
          affiliations: snap.affiliations ?? [],
          available_resources: snap.available_resources ?? [],
          retrieval_sources: snap.retrieval_sources ?? [],
          retrieval_latency_ms: snap.retrieval_latency_ms ?? {},
          relevant_locations: snap.relevant_locations ?? [],
          relevant_objects: snap.relevant_objects ?? [],
          available_capabilities: snap.available_capabilities ?? [],
          summary: snap.summary ?? { entity_count: 0, relationship_count: 0, context_event_count: 0, experience_count: 0 },
        })
        setSemanticMemory({
          ...memory,
          retrieved_this_execution: memory.retrieved_this_execution ?? { experiences: [], conversations: [] },
          durable_beliefs: memory.durable_beliefs ?? [],
        })
        setError('')
      })
      .catch((err) => { if (!cancelled) setError(err instanceof Error ? err.message : String(err)) })
    return () => { cancelled = true }
  }, [selectedActorId, executionId])

  if (dashboard && !groundingRoute) {
    const pageTitle = location.pathname.split('/').filter(Boolean).map((part) => part.replace(/-/g, ' ')).map((part) => part.replace(/^./, (c) => c.toUpperCase())).join(' · ')
    if (location.pathname === '/execution-debugger/plan') {
      return <DashboardFrame dashboard>
        <div className="lwe-plan-page"><div className="lwe-plan-stack"><PlanningDetailsPanel /><ExecutionGraphPanel /><PlanReplacementHistoryPanel /></div></div>
      </DashboardFrame>
    }
    if (location.pathname === '/execution-debugger/conversations') {
      return <DashboardFrame dashboard>
        <div className="lwe-plan-page"><ConversationTimelinePanel /></div>
      </DashboardFrame>
    }
    if (location.pathname === '/world-map') {
      return <DashboardFrame dashboard debuggerPage={false}>
        <div className="lwe-plan-page"><div className="lwe-world-impact-stack"><GeographyPanel /><MapPanel /></div></div>
      </DashboardFrame>
    }
    if (location.pathname === '/timeline') {
      return <DashboardFrame dashboard debuggerPage={false}>
        <div className="lwe-timeline-image-page">
          <img src="/assets/milk_store_heatmaps.png" alt="Milk store comparison heatmaps across 300 epochs" />
        </div>
      </DashboardFrame>
    }
    if (location.pathname === '/affiliations') {
      return <DashboardFrame dashboard debuggerPage={false}>
        <div className="lwe-plan-page"><AffiliationsPanel /></div>
      </DashboardFrame>
    }
    if (location.pathname === '/knowledge-graph') {
      return <DashboardFrame dashboard debuggerPage={false}>
        <div className="lwe-plan-page" style={{ height: '100%', display: 'flex', flexDirection: 'column' }}><KnowledgeGraphPanel /></div>
      </DashboardFrame>
    }
    if (location.pathname === '/execution-debugger/metrics') {
      return <DashboardFrame dashboard>
        <div className="lwe-plan-page"><InspectorPanel includeExecutionHistory={false} includeMemory={false} includePlanReplacementHistory={false} includePlanningSummary={false} includeSocietyView={false} /></div>
      </DashboardFrame>
    }
    if (location.pathname === '/execution-debugger/memories') {
      return <DashboardFrame dashboard>
        <div className="lwe-plan-page"><MemoryPanel /></div>
      </DashboardFrame>
    }
    if (location.pathname === '/execution-debugger/logs') {
      return <DashboardFrame dashboard>
        <div className="lwe-plan-page"><ExecutionHistoryPanel /></div>
      </DashboardFrame>
    }
    if (location.pathname === '/actors' || location.pathname === '/agents') {
      return <DashboardFrame dashboard debuggerPage={false}><div className="lwe-plan-page"><AgentsPanel /></div></DashboardFrame>
    }
    if (location.pathname === '/societies') {
      return <DashboardFrame dashboard debuggerPage={false}><div className="lwe-plan-page"><SocietiesPanel /></div></DashboardFrame>
    }
    if (location.pathname === '/context-stream') {
      return <DashboardFrame dashboard debuggerPage={false}><div className="lwe-plan-page"><EventStreamPanel /></div></DashboardFrame>
    }
    if (location.pathname === '/memories') {
      return <DashboardFrame dashboard debuggerPage={false}><div className="lwe-plan-page"><ContextMemoryPanel /></div></DashboardFrame>
    }
    return <DashboardFrame dashboard>
      <DashboardPage title={pageTitle || 'Dashboard'} description="This is an independent dashboard page. Its live data view is scoped to the selected actor and execution." />
    </DashboardFrame>
  }

  if (!selectedActorId) {
    return <DashboardFrame dashboard={dashboard}>
      <div className="lwe-inspector-muted" style={{ padding: '12px' }}>
        Select an actor (World Tree — BY ACTOR, or the Map) to see what grounded their most recent planning cycle.
      </div>
    </DashboardFrame>
  }

  const name = cognitiveState?.identity.name ?? selectedActorId
  const exportSnapshot = () => {
    if (!snapshot) return
    const blob = new Blob([JSON.stringify(snapshot, null, 2)], { type: 'application/json' })
    const url = URL.createObjectURL(blob)
    const anchor = document.createElement('a')
    anchor.href = url
    anchor.download = `execution-grounding-${snapshot.execution_id}.json`
    anchor.click()
    URL.revokeObjectURL(url)
  }
  
  // Pre-filter helper function - filters rows based on search query
  const filterRows = useMemo(() => {
    if (!search.trim()) return (rows: Array<Record<string, unknown>>) => rows
    const q = search.trim().toLowerCase()
    return (rows: Array<Record<string, unknown>>) => rows.filter((row) => {
      return Object.values(row).some((val) => {
        if (val == null) return false
        if (Array.isArray(val)) {
          return val.some((v) => String(v).toLowerCase().includes(q))
        }
        return String(val).toLowerCase().includes(q)
      })
    })
  }, [search])

  // Forces each ActorTable below to remount (clearing its local filter
  // text) whenever the actor or execution being displayed changes.
  // ActorTable keeps its filter in local useState, and without this key
  // React reuses the same instance across actor switches — so a filter
  // typed while looking at one actor's rows would silently stay applied
  // to the next, completely different, actor's rows.
  const tableResetKey = `${selectedActorId}-${executionId}`
  
  // Determine which sections to show based on active tab
  // 'kg' = Knowledge Graph/Plan tab, 'semantic' = Conversations/World Impact/Metrics, 'diff' = Logs
  const showKnowledgeGraph = activeFilter === 'all' || activeFilter === 'kg'
  const showContext = activeFilter === 'all' || activeFilter === 'semantic'
  const showSemantic = activeFilter === 'all' || activeFilter === 'semantic'
  const showAffiliation = activeFilter === 'all' || activeFilter === 'semantic'
  const showExternal = activeFilter === 'all' || activeFilter === 'semantic'
  const showDiff = activeFilter === 'all' || activeFilter === 'diff'

  return <DashboardFrame dashboard={dashboard} onExport={exportSnapshot}><div className="lwe-inspector">
    <div className="lwe-inspector-tier">Grounding — {name}</div>

    {!executionId && !error && <div className="lwe-inspector-muted">No executions recorded for this actor yet.</div>}
    {error && <div className="lwe-inspector-error">{error}</div>}
    
    {/* Global search/filter input */}
    {snapshot && (
      <div style={{ marginBottom: 16 }}>
        <input
          type="text"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          placeholder="Filter data..."
          className="lwe-inspector-filter"
          style={{
            width: '100%',
            padding: '8px 12px',
            borderRadius: 6,
            border: '1px solid var(--border-color,#444)',
            background: 'var(--panel-bg,#111)',
            color: 'inherit',
            outline: 'none',
          }}
        />
      </div>
    )}

    {snapshot && <>
      <ActorSection title="Constructed Context Size">
        <div className="lwe-inspector-value">
          {snapshot.summary.entity_count} entities, {snapshot.summary.relationship_count} relationships, {snapshot.summary.context_event_count} context events
        </div>
        <div className="lwe-inspector-value">
          {snapshot.summary.semantic_memory_count ?? 0} semantic memories, {snapshot.summary.episodic_memory_count ?? 0} episodic memories, {snapshot.summary.affiliation_count ?? snapshot.affiliations.length} affiliations
        </div>
        <div className="lwe-inspector-hint">Planner input: {snapshot.prompt_tokens || 'unknown'} tokens; sources: {snapshot.retrieval_sources.join(', ') || 'none recorded'}.</div>
        <div className="lwe-inspector-hint">From this actor's most recent real execution ({formatTime(snapshot.created_at)}).</div>
      </ActorSection>

      {showKnowledgeGraph && (
        <ActorSection title="Knowledge Graph">
        {snapshot.knowledge.length + snapshot.relationships.length > 0
          ? (() => {
              const kgRows = filterRows([...snapshot.knowledge, ...snapshot.relationships].map((item) => ({
                Type: item.item_type, Content: item.content, Confidence: item.confidence.toFixed(2),
              })))
              return kgRows.length > 0 ? (
                <ActorTable key={`kg-${tableResetKey}`} columns={['Type', 'Content', 'Confidence']} rows={kgRows} />
              ) : (
                <div className="lwe-inspector-muted">No matching knowledge graph entries.</div>
              )
            })()
          : <div className="lwe-inspector-muted">None recorded.</div>}
      </ActorSection>

      {showContext && (
        <ActorSection title="Context Stream">
          {snapshot.context_events.length > 0
            ? (() => {
                const ctxRows = filterRows(snapshot.context_events.map((item) => ({
                  Time: formatTime(item.timestamp), Source: item.source, Content: item.content,
                })))
                return ctxRows.length > 0 ? (
                  <ActorTable key={`ctx-${tableResetKey}`} columns={['Time', 'Source', 'Content']} rows={ctxRows} />
                ) : (
                  <div className="lwe-inspector-muted">No matching context events.</div>
                )
              })()
            : <div className="lwe-inspector-muted">No context events grounded this execution.</div>}
        </ActorSection>
      )}

      {showSemantic && (
        <ActorSection title="Semantic Memory">
          <div className="lwe-inspector-hint">Retrieved for this execution (episodic experience search) vs. durable beliefs (observed 2+ times).</div>
          {semanticMemory && (semanticMemory.retrieved_this_execution.experiences.length > 0 || semanticMemory.retrieved_this_execution.conversations.length > 0)
            ? (() => {
                const semRows = filterRows([...semanticMemory.retrieved_this_execution.experiences, ...semanticMemory.retrieved_this_execution.conversations].map((item) => ({
                  Type: item.item_type, Content: item.content,
                })))
                return semRows.length > 0 ? (
                  <ActorTable key={`sem-${tableResetKey}`} columns={['Type', 'Content']} rows={semRows} />
                ) : (
                  <div className="lwe-inspector-muted">No matching semantic memories.</div>
                )
              })()
            : <div className="lwe-inspector-muted">No experiences retrieved for this execution.</div>}
          {semanticMemory && semanticMemory.durable_beliefs.length > 0 && (() => {
            const beliefRows = filterRows(semanticMemory.durable_beliefs.map((b) => ({
              Subject: b.subject, Belief: readable(b.value), Confidence: b.confidence.toFixed(2),
            })))
            return beliefRows.length > 0 ? (
              <ActorTable key={`beliefs-${tableResetKey}`} columns={['Subject', 'Belief', 'Confidence']} rows={beliefRows} />
            ) : (
              <div className="lwe-inspector-muted">No matching durable beliefs.</div>
            )
          })()}
        </ActorSection>
      )}

      {showAffiliation && (
        <ActorSection title="Affiliation Graph">
          {snapshot.affiliations.length > 0
            ? (() => {
                const affRows = filterRows(snapshot.affiliations.map((a) => ({
                  Society: String(a.society_name || a.society_id || ''), Roles: Array.isArray(a.roles) ? a.roles.join(', ') : '', Trust: String(a.trust_score ?? ''), Permissions: Array.isArray(a.permissions) ? a.permissions.join(', ') : '',
                })))
                return affRows.length > 0 ? (
                  <ActorTable key={`aff-${tableResetKey}`} columns={['Society', 'Roles', 'Trust', 'Permissions']} rows={affRows} />
                ) : (
                  <div className="lwe-inspector-muted">No matching affiliations.</div>
                )
              })()
            : <div className="lwe-inspector-muted">Affiliation graph was not queried for this execution.</div>}
        </ActorSection>
      )}

      <ActorSection title="World State">
        <div className="lwe-inspector-hint">Locations and objects the planning cycle actually referenced.</div>
        <dl className="lwe-inspector-fields">
          <dt>Relevant Locations</dt><dd>{snapshot.relevant_locations.join(', ') || 'None recorded.'}</dd>
          <dt>Relevant Objects</dt><dd>{snapshot.relevant_objects.join(', ') || 'None recorded.'}</dd>
          <dt>Available Capabilities</dt><dd>{snapshot.available_capabilities.join(', ') || 'None recorded.'}</dd>
        </dl>
      </ActorSection>

      {showExternal && (
        <ActorSection title="External Events">
          {externalEventsFrom(snapshot).length > 0
            ? (() => {
                const extRows = filterRows(externalEventsFrom(snapshot).map((item) => ({
                  Time: formatTime(item.timestamp), Description: item.content,
                })))
                return extRows.length > 0 ? (
                  <ActorTable key={`ext-${tableResetKey}`} columns={['Time', 'Description']} rows={extRows} />
                ) : (
                  <div className="lwe-inspector-muted">No matching external events.</div>
                )
              })()
            : <div className="lwe-inspector-muted">No external perturbations were reported for this execution.</div>}
        </ActorSection>
      )}

      {showDiff && (
        <ActorSection title="Context Diff (vs. previous planning cycle)">
          {snapshot.diff_from_previous?.is_first_context
            ? <div className="lwe-inspector-hint">First planning cycle for this actor — nothing to diff against.</div>
            : snapshot.diff_from_previous && (() => {
                const diffRows = filterRows(Object.keys(snapshot.diff_from_previous.added).map((source) => ({
                  Source: source,
                  Added: snapshot.diff_from_previous!.added[source].join('; ') || 'None',
                  Removed: snapshot.diff_from_previous!.removed[source].join('; ') || 'None',
                })))
                return diffRows.length > 0 ? (
                  <ActorTable key={`diff-${tableResetKey}`} columns={['Source', 'Added', 'Removed']} rows={diffRows} />
                ) : (
                  <div className="lwe-inspector-muted">No matching diff entries.</div>
                )
              })()
          }
        </ActorSection>
      )}
    </>}
  </div></DashboardFrame>
}